---
import type { CaseCard } from "../content/content";
import T from "./T.astro";
import Badge from "./Badge.astro";
interface Props { card: CaseCard; letter: string }
const { card, letter } = Astro.props;
---
<article class="border-t border-line pt-6" aria-labelledby={`case-${card.id}`}>
  <div class="flex flex-wrap items-baseline gap-3">
    <span class="font-mono text-xs text-muted">CASE {letter}</span>
    {card.badge && <Badge label={card.badge} />}
  </div>
  <h3 id={`case-${card.id}`} class="mt-2 text-xl font-semibold text-ink">{card.title}</h3>
  {card.stat && <p class="mt-3 font-mono text-3xl sm:text-4xl font-semibold text-iron-ink">{card.stat}</p>}
  <dl class="mt-4 grid gap-3 text-[0.95rem] leading-relaxed">
    <div><dt class="font-mono text-xs uppercase tracking-wider text-muted">Problem</dt><dd><T text={card.problem} /></dd></div>
    <div><dt class="font-mono text-xs uppercase tracking-wider text-muted">What I did</dt><dd><T text={card.whatIDid} /></dd></div>
    {card.result && <div><dt class="font-mono text-xs uppercase tracking-wider text-muted">Result</dt><dd><T text={card.result} /></dd></div>}
  </dl>
  {card.note && <p class="mt-4 text-sm text-muted border-l-2 border-line pl-3"><T text={card.note} /></p>}
  {card.cta && <a href={card.cta.href} class="mt-4 inline-block font-medium underline underline-offset-4 decoration-1 hover:decoration-2">{card.cta.label}</a>}
</article>
