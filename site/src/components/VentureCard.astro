---
import type { Venture } from "../content/content";
import T from "./T.astro";
import Badge from "./Badge.astro";
interface Props { v: Venture }
const { v } = Astro.props;
---
<article class="border border-line rounded-md p-5 bg-paper-raised">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="text-lg font-semibold text-ink">{v.name}</h3>
    <Badge label={v.status} />
  </div>
  <dl class="mt-3 grid gap-2 text-[0.95rem] leading-relaxed">
    <div><dt class="sr-only">What it is</dt><dd><T text={v.whatItIs} /></dd></div>
    <div class="flex gap-2"><dt class="font-mono text-xs uppercase tracking-wider text-muted pt-1">Role</dt><dd>{v.role}</dd></div>
    <div><dt class="font-mono text-xs uppercase tracking-wider text-muted">Proof</dt><dd><T text={v.proof} /></dd></div>
  </dl>
</article>
